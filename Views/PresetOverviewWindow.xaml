<Window x:Class="NetAdapterManager.Views.PresetOverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="预设管理" Width="920" Height="700" MinWidth="760" MinHeight="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False">
    <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1" CornerRadius="6" Padding="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>
            <Grid Background="{DynamicResource HeaderBackground}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="预设管理" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" />
                <Button Content="×" Width="36" Height="32" Padding="0" Margin="0,7,6,7" HorizontalAlignment="Right"
                        Click="Close_Click" Style="{StaticResource QuietButton}" />
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="14" Margin="16,14,16,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="330" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="全部预设" Style="{StaticResource SectionTitleStyle}" />
                            <Border Background="{DynamicResource HeaderBadgeBackground}" BorderBrush="{DynamicResource HeaderBadgeBorder}"
                                    BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="10,0,0,0">
                                <TextBlock x:Name="CountText" Text="{Binding PresetCountText}" Foreground="{DynamicResource PrimaryColor}" FontSize="11" />
                            </Border>
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="当前网卡" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}"
                                      ToolTip="选择应用预设或新建预设所使用的网卡">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding MacAddressText}" Foreground="{DynamicResource MutedText}" FontSize="10" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Grid>
                    <Grid Margin="0,10,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="OverviewGroupFilter" ItemsSource="{Binding PresetGroups}" SelectedItem="{Binding PresetGroupFilter}" ToolTip="按预设分组筛选" />
                        <TextBlock Grid.Column="1" Text="搜索预设" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        <TextBox x:Name="OverviewSearchBox" Grid.Column="2" Text="{Binding PresetSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="8,3,0,7" ToolTip="搜索预设名称、分组、网卡、IP 或 DNS" />
                        <Button Grid.Column="3" Content="清除筛选" Command="{Binding ClearPresetFilterCommand}"
                                Style="{StaticResource QuietButton}" Margin="8,0,0,0" />
                    </Grid>
                    <WrapPanel>
                        <Button x:Name="OverviewNewButton" Content="新建预设" Command="{Binding SavePresetCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button x:Name="OverviewApplyButton" Content="应用" Command="{Binding ApplyPresetCommand}" CommandParameter="{Binding SelectedPreset}" Style="{StaticResource PrimaryButton}" />
                        <Button x:Name="OverviewEditButton" Content="编辑" Command="{Binding EditPresetCommand}" Style="{StaticResource QuietButton}" />
                        <Button x:Name="OverviewDeleteButton" Content="删除" Command="{Binding DeletePresetCommand}" Style="{StaticResource DangerButton}" />
                        <Button x:Name="OverviewAddGroupButton" Content="添加分组" Command="{Binding AddPresetGroupCommand}" Style="{StaticResource QuietButton}" />
                        <Button x:Name="OverviewDeleteGroupButton" Content="删除分组" Command="{Binding DeletePresetGroupCommand}" Style="{StaticResource DangerButton}" />
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                        <Button Content="全选当前列表" Click="SelectAll_Click" Style="{StaticResource QuietButton}" />
                        <Button Content="取消勾选" Click="ClearSelection_Click" Style="{StaticResource QuietButton}" />
                        <ComboBox x:Name="BatchGroupBox" Width="140" ItemsSource="{Binding PresetGroups}" ToolTip="批量移动到分组" />
                        <Button x:Name="BatchMoveButton" Content="批量换分组" Click="BatchMove_Click" Style="{StaticResource QuietButton}" />
                        <Button x:Name="BatchDeleteButton" Content="批量删除" Click="BatchDelete_Click" Style="{StaticResource DangerButton}" />
                        <TextBlock x:Name="BatchCountText" Text="已勾选 0 项" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource MutedText}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <ListBox x:Name="OverviewPresetList" Grid.Row="2" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" Margin="16,0,16,10" MouseDoubleClick="PresetList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsBatchSelected, Mode=TwoWay}" Click="BatchSelection_Click" VerticalAlignment="Top" ToolTip="勾选用于批量操作" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding AdapterSummary}" Foreground="{DynamicResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,12,3" />
                                    <TextBlock Grid.Column="1" Text="{Binding MacSummary}" Foreground="{DynamicResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="12,0,0,3" />
                                    <TextBlock Grid.Row="1" Text="{Binding IpSummary}" Foreground="{DynamicResource TextColor}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,12,3" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DnsSummary}" Foreground="{DynamicResource TextColor}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="12,0,0,3" />
                                    <TextBlock Grid.Row="2" Text="{Binding GroupName, StringFormat=分组：{0}}" Foreground="{DynamicResource PrimaryColor}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="12,0,0,0" />
                                </Grid>
                            </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Row="3" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource HeaderBorder}"
                    BorderThickness="0,1,0,0" Padding="14,9">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextColor}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DetailMessage}" Foreground="{DynamicResource DangerColor}" FontSize="11" />
                    </StackPanel>
                    <Button Content="关闭" Click="Close_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
