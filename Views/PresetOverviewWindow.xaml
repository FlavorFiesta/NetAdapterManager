<Window x:Class="NetAdapterManager.Views.PresetOverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:NetAdapterManager.ViewModels"
        Title="{DynamicResource Loc_71D67829CAF4}" Width="920" Height="700" MinWidth="760" MinHeight="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource TextColor}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False">
    <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1" CornerRadius="6" Padding="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>
            <Grid Background="{DynamicResource HeaderBackground}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock TextWrapping="Wrap" Text="{DynamicResource Loc_71D67829CAF4}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" />
                <Button Content="×" Width="36" Height="32" Padding="0" Margin="0,7,6,7" HorizontalAlignment="Right"
                        Click="Close_Click" Style="{StaticResource QuietButton}" />
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="14" Margin="16,14,16,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="330" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock TextWrapping="Wrap" Text="{DynamicResource Loc_6BCDDAB012D0}" Style="{StaticResource SectionTitleStyle}" />
                            <Border Background="{DynamicResource HeaderBadgeBackground}" BorderBrush="{DynamicResource HeaderBadgeBorder}"
                                    BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="10,0,0,0">
                                <TextBlock TextWrapping="Wrap" x:Name="CountText" Text="{Binding PresetCountText}" Foreground="{DynamicResource PrimaryColor}" FontSize="11" />
                            </Border>
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock TextWrapping="Wrap" Text="{DynamicResource Loc_A7785B7E395E}" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}"
                                      ToolTip="{DynamicResource Loc_48F6B9E3225B}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock TextWrapping="Wrap" Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock TextWrapping="Wrap" Text="{Binding MacAddressText}" Foreground="{DynamicResource MutedText}" FontSize="10" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Grid>
                    <Grid Margin="0,10,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="OverviewGroupFilter" ItemsSource="{Binding PresetGroups}" ItemTemplate="{StaticResource GroupItemTemplate}" SelectedItem="{Binding PresetGroupFilter}" ToolTip="{DynamicResource Loc_C1471C92B129}" />
                        <TextBlock TextWrapping="Wrap" Grid.Column="1" Text="{DynamicResource Loc_36C818B1C6B4}" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        <TextBox x:Name="OverviewSearchBox" Grid.Column="2" Text="{Binding PresetSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="8,3,0,7" ToolTip="{DynamicResource Loc_9FE56367749D}" />
                        <Button Grid.Column="3" Content="{DynamicResource Loc_657D9CBF45EC}" Command="{Binding ClearPresetFilterCommand}"
                                Style="{StaticResource QuietButton}" Margin="8,0,0,0" />
                    </Grid>
                    <WrapPanel>
                        <Button x:Name="OverviewNewButton" Content="{DynamicResource Loc_A61BC16CA0F6}" Command="{Binding SavePresetCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button x:Name="OverviewApplyButton" Content="{DynamicResource Loc_63C73C4730F4}" Command="{Binding ApplyPresetCommand}" CommandParameter="{Binding SelectedPreset}" Style="{StaticResource PrimaryButton}" />
                        <Button x:Name="OverviewEditButton" Content="{DynamicResource Loc_051836569928}" Command="{Binding EditPresetCommand}" Style="{StaticResource QuietButton}" />
                        <Button x:Name="OverviewDeleteButton" Content="{DynamicResource Loc_2F9DAA828907}" Command="{Binding DeletePresetCommand}" Style="{StaticResource DangerButton}" />
                        <Button x:Name="OverviewAddGroupButton" Content="{DynamicResource Loc_C3FA53918CC9}" Command="{Binding AddPresetGroupCommand}" Style="{StaticResource QuietButton}" />
                        <Button x:Name="OverviewDeleteGroupButton" Content="{DynamicResource Loc_7605C1D82EED}" Command="{Binding DeletePresetGroupCommand}" Style="{StaticResource DangerButton}" />
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                        <Button Content="{DynamicResource Loc_70B25D866A2E}" Click="SelectAll_Click" Style="{StaticResource QuietButton}" />
                        <Button Content="{DynamicResource Loc_35442C038DB9}" Click="ClearSelection_Click" Style="{StaticResource QuietButton}" />
                        <ComboBox x:Name="BatchGroupBox" Width="140" ItemsSource="{Binding PresetGroups}" ItemTemplate="{StaticResource GroupItemTemplate}" ToolTip="{DynamicResource Loc_0C918C6FDE83}" />
                        <Button x:Name="BatchMoveButton" Content="{DynamicResource Loc_29C37EA0105B}" Click="BatchMove_Click" Style="{StaticResource QuietButton}" />
                        <Button x:Name="BatchDeleteButton" Content="{DynamicResource Loc_DDAE7A0FC554}" Click="BatchDelete_Click" Style="{StaticResource DangerButton}" />
                        <TextBlock TextWrapping="Wrap" x:Name="BatchCountText" Text="{DynamicResource Loc_1B21B8D1F61F}" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource MutedText}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <ListBox x:Name="OverviewPresetList" Grid.Row="2" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" Margin="16,0,16,10" MouseDoubleClick="PresetList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsBatchSelected, Mode=TwoWay}" Click="BatchSelection_Click" VerticalAlignment="Top" ToolTip="{DynamicResource Loc_AE84400C1446}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding AdapterSummary}" Foreground="{DynamicResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,12,3" />
                                    <TextBlock Grid.Column="1" Text="{Binding MacSummary}" Foreground="{DynamicResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="12,0,0,3" />
                                    <TextBlock Grid.Row="1" Text="{Binding IpSummary}" Foreground="{DynamicResource TextColor}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,12,3" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DnsSummary}" Foreground="{DynamicResource TextColor}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="12,0,0,3" />
                                    <TextBlock Grid.Row="2" Text="{ui:LocalizedValue Path=GroupName, Kind=groupSummary}" Foreground="{DynamicResource PrimaryColor}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                    <TextBlock TextWrapping="Wrap" Grid.Row="2" Grid.Column="1" Text="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="12,0,0,0" />
                                </Grid>
                            </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Row="3" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource HeaderBorder}"
                    BorderThickness="0,1,0,0" Padding="14,9">
                <Grid>
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="{Binding StatusMessage}" Foreground="{DynamicResource TextColor}" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding DetailMessage}" Foreground="{DynamicResource DangerColor}" FontSize="11" />
                    </StackPanel>
                    <Button Content="{DynamicResource Loc_3FD47EDCE45B}" Click="Close_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
