<Window x:Class="NetAdapterManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:NetAdapterManager.ViewModels"
        Title="{DynamicResource Loc_EC57B32F8731}" Width="1160" Height="800" MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Topmost="{Binding IsTopmost}"
        Icon="{StaticResource AppIcon}" Foreground="{DynamicResource TextColor}">
    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,16,16,14" MaxWidth="1440" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="440" />
                <ColumnDefinition Width="1*" MinWidth="440" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource CardBorderStyle}" Background="{DynamicResource SoftBlue}" Padding="14" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock TextWrapping="Wrap" Text="{DynamicResource Loc_D1672F5617FE}" Foreground="{DynamicResource MutedText}" FontSize="12" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1" CornerRadius="2" Padding="8,3" Margin="9,0,0,0">
                                    <TextBlock TextWrapping="Wrap" Text="{ui:LocalizedValue Path=Adapters.Count, Kind=count}" Foreground="{DynamicResource PrimaryColor}" FontSize="11" />
                                </Border>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Content="{DynamicResource Loc_CAF3624C5177}" IsChecked="{Binding HideVirtual}" VerticalAlignment="Center" />

                            <ComboBox x:Name="AdapterSelector" Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding Adapters}"
                                       SelectedItem="{Binding SelectedAdapter}" Margin="0,8,0,8"
                                       MaxDropDownHeight="390">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinWidth="420" Margin="2,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding IPv4Summary}" Foreground="{DynamicResource MutedText}"
                                                           FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding MacAddressText}" Foreground="{DynamicResource MutedText}"
                                                           FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0" HorizontalAlignment="Right">
                                                <TextBlock TextWrapping="Wrap" Text="{Binding EnabledText}" HorizontalAlignment="Right" FontSize="11" />
                                                <TextBlock TextWrapping="Wrap" Text="{Binding TypeText}" Foreground="{DynamicResource MutedText}"
                                                           HorizontalAlignment="Right" FontSize="11" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Text="{DynamicResource Loc_5C26AEA1497D}" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock TextWrapping="Wrap" Text="{DynamicResource Loc_B63B4C3DF7EE}"
                                       Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,4,0,12" />
                            <TextBlock TextWrapping="Wrap" Text="{DynamicResource Loc_35654FA0CB49}" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="{DynamicResource Loc_620D67C03E6D}" IsChecked="{Binding IsDhcp}" GroupName="IpMode" />
                                <RadioButton Content="{DynamicResource Loc_69050783CAFB}" IsChecked="{Binding IsStatic}" GroupName="IpMode" />
                            </StackPanel>
                            <Grid IsEnabled="{Binding IsStatic}" Margin="0,0,0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock TextWrapping="Wrap" Text="{DynamicResource Loc_EDDFCE79A619}" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding IPv4Address, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock TextWrapping="Wrap" Grid.Row="1" Text="{DynamicResource Loc_50832184B754}" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PrefixInput, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock TextWrapping="Wrap" Grid.Row="2" Text="{DynamicResource Loc_51AAE58F282E}" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Gateway, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Text="{DynamicResource Loc_F253293B1C7A}" Style="{StaticResource SectionTitleStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="{DynamicResource Loc_EE203172B7E7}" IsChecked="{Binding IsDnsAutomatic}"
                                             GroupName="DnsMode" ToolTip="{DynamicResource Loc_989AA413A7FB}" />
                                <RadioButton Content="{DynamicResource Loc_7046ECFB8361}" IsChecked="{Binding IsDnsStatic}" GroupName="DnsMode" />
                            </StackPanel>
                            <Grid IsEnabled="{Binding IsDnsStatic}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock TextWrapping="Wrap" Text="{DynamicResource Loc_3EA51B185EAA}" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding PreferredDns, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock TextWrapping="Wrap" Grid.Row="1" Text="{DynamicResource Loc_D3E3C8F130A7}" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AlternateDns, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Border Background="{DynamicResource WarningBackground}" BorderBrush="{DynamicResource WarningBorder}"
                                    BorderThickness="1" CornerRadius="2" Padding="11" Margin="0,6,0,14">
                                <StackPanel>
                                    <TextBlock Text="{Binding ConfigurationNoticeText}"
                                               Foreground="{DynamicResource WarningText}" TextWrapping="Wrap" FontSize="12" />
                                    <TextBlock Text="{DynamicResource Editor.Draft}" Margin="0,5,0,0"
                                               Foreground="{DynamicResource WarningText}" TextWrapping="Wrap" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="1" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource HeaderBorder}"
                        BorderThickness="1" Padding="8" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="{DynamicResource Loc_670F0A1D31C0}" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" Margin="4,0" />
                        <Button Content="{DynamicResource Loc_D2AA9AC606D7}" Command="{Binding SavePresetCommand}" Style="{StaticResource QuietButton}" Margin="4,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="1">
                <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock TextWrapping="Wrap" Text="{DynamicResource Loc_F1DE1E2621DE}" Style="{StaticResource SectionTitleStyle}" />
                                    <Border Background="{DynamicResource HeaderBadgeBackground}" BorderBrush="{DynamicResource HeaderBadgeBorder}"
                                            BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock TextWrapping="Wrap" x:Name="PresetCountText" Text="{Binding PresetCountText}" Foreground="{DynamicResource PrimaryColor}" FontSize="11" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="RestorePresetBackupButton" Content="{DynamicResource Loc_1AE486278078}" Command="{Binding RestorePresetBackupCommand}" Style="{StaticResource QuietButton}" Padding="10,4" ToolTip="{DynamicResource Loc_F76847128075}" />
                                    <Button x:Name="PresetOverviewButton" Content="{DynamicResource Loc_FA2FF3C379A7}" Command="{Binding ViewAllPresetsCommand}" Style="{StaticResource QuietButton}"
                                            Padding="10,4" ToolTip="{DynamicResource Loc_E0FDFD2148A1}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock TextWrapping="Wrap" Text="{DynamicResource Loc_9005AF73B7B6}" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,4,0,10" />
                            <TextBlock TextWrapping="Wrap" Text="{DynamicResource Loc_E9E33A982D20}" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,0,0,1" />
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="135" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <ComboBox Width="135" ItemsSource="{Binding PresetGroups}" ItemTemplate="{StaticResource GroupItemTemplate}" SelectedItem="{Binding PresetGroupFilter}"
                                          ToolTip="{DynamicResource Loc_B1B4F3BDDA83}" />
                                <TextBox Grid.Column="1" Text="{Binding PresetSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="8,3,0,7" ToolTip="{DynamicResource Loc_B3E18C1F370F}" />
                            </Grid>
                             <WrapPanel Margin="0,1,0,12">
                                 <Button Content="{DynamicResource Loc_63C73C4730F4}" Command="{Binding ApplyPresetCommand}" CommandParameter="{Binding SelectedPreset}" Style="{StaticResource PrimaryButton}" />
                                 <Button Content="{DynamicResource Loc_051836569928}" Command="{Binding EditPresetCommand}" Style="{StaticResource QuietButton}" />
                                 <Button Content="{DynamicResource Loc_2F9DAA828907}" Command="{Binding DeletePresetCommand}" Style="{StaticResource DangerButton}" />
                                 <Button x:Name="AddPresetGroupButton" Content="{DynamicResource Loc_C3FA53918CC9}" Command="{Binding AddPresetGroupCommand}"
                                         Style="{StaticResource QuietButton}" />
                             </WrapPanel>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" MouseDoubleClick="PresetList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                            <TextBlock Text="{Binding AdapterSummary}" Foreground="{DynamicResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,8,2" />
                                            <TextBlock Grid.Column="1" Text="{Binding MacSummary}" Foreground="{DynamicResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="8,0,0,2" />
                                            <TextBlock Grid.Row="1" Text="{Binding IpSummary}" Foreground="{DynamicResource TextColor}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,8,2" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DnsSummary}" Foreground="{DynamicResource TextColor}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="8,0,0,2" />
                                            <TextBlock Grid.Row="2" Text="{ui:LocalizedValue Path=GroupName, Kind=groupSummary}" Foreground="{DynamicResource PrimaryColor}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                            <TextBlock TextWrapping="Wrap" Grid.Row="2" Grid.Column="1" Text="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="8,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource HeaderBorder}"
                BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Text="{Binding StatusMessage}" Foreground="{DynamicResource TextColor}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DetailMessage}" Foreground="{DynamicResource DangerColor}" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Text="{Binding WarningMessage}" Foreground="{DynamicResource WarningText}" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <WrapPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock TextWrapping="Wrap" Text="{Binding VersionText}" Foreground="{DynamicResource MutedText}"
                               VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock TextWrapping="Wrap" Text="{Binding LastRefreshText}" Foreground="{DynamicResource MutedText}"
                               VerticalAlignment="Center" Margin="0,0,16,0" />
                    </WrapPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource HeaderBadgeBackground}" BorderBrush="{DynamicResource HeaderBadgeBorder}"
                            BorderThickness="1" CornerRadius="2" Padding="11,7" Margin="0,0,8,0">
                        <TextBlock TextWrapping="Wrap" Text="{DynamicResource Loc_3985AFB218A7}" Foreground="{DynamicResource PrimaryColor}" FontSize="12" />
                    </Border>
                    <Button Command="{Binding ToggleTopmostCommand}" Style="{StaticResource QuietButton}"
                            Width="40" Height="36" Padding="0" Margin="0,0,8,0"
                            ToolTip="{Binding TopmostToggleText}"
                            AutomationProperties.Name="{Binding TopmostToggleText}">
                        <TextBlock TextWrapping="Wrap" Text="{Binding TopmostIconText}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Content="{DynamicResource Settings.Title}" Click="Settings_Click" Style="{StaticResource QuietButton}"/>
                    <Button Content="{DynamicResource Loc_F058FE3DA703}" Command="{Binding OpenNetworkConnectionsCommand}"
                            Style="{StaticResource QuietButton}" ToolTip="{DynamicResource Loc_5E38EF80FE5A}" />
                    <Button Content="{DynamicResource Loc_0D01866EE42E}" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}" Margin="0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="OperationToast" Grid.Row="1"
                HorizontalAlignment="Center" VerticalAlignment="Center" Width="380"
                Margin="0" Padding="13,11" CornerRadius="4"
                Background="{DynamicResource CardBackground}" Panel.ZIndex="20"
                IsHitTestVisible="{Binding IsToastVisible}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessColor}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastSucceeded}" Value="False">
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerColor}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsToastVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.7" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock TextWrapping="Wrap" Grid.Column="0" FontSize="20" FontWeight="Bold" VerticalAlignment="Top"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="✓" />
                            <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastSucceeded}" Value="False">
                                    <Setter Property="Text" Value="!" />
                                    <Setter Property="Foreground" Value="{DynamicResource DangerColor}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock TextWrapping="Wrap" Text="{Binding ToastTitle}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ToastDetail}" Foreground="{DynamicResource MutedText}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
