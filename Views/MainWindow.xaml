 </Grid>
 <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Margin="0,8,0,12"/>
 <StackPanel Orientation="Horizontal">
 <TextBlock Text="{DynamicResource Loc_F253293B1C7A}" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
