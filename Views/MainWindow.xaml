<Window x:Class="NetAdapterManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="网络适配器管理器" Width="1160" Height="800" MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Topmost="{Binding IsTopmost}"
        Icon="{StaticResource AppIcon}">
    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,16,16,14" MaxWidth="1440" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="480" />
                <ColumnDefinition Width="1*" MinWidth="480" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource CardBorderStyle}" Background="{DynamicResource SoftBlue}" Padding="14" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="当前目标" Foreground="{DynamicResource MutedText}" FontSize="12" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1" CornerRadius="2" Padding="8,3" Margin="9,0,0,0">
                                    <TextBlock Text="{Binding Adapters.Count, StringFormat={}{0} 个网卡}" Foreground="{DynamicResource PrimaryColor}" FontSize="11" />
                                </Border>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Content="隐藏虚拟" IsChecked="{Binding HideVirtual}" VerticalAlignment="Center" />

                            <ComboBox x:Name="AdapterSelector" Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding Adapters}"
                                       SelectedItem="{Binding SelectedAdapter}" Margin="0,8,0,8"
                                       MaxDropDownHeight="390">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinWidth="420" Margin="2,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding IPv4Summary}" Foreground="{DynamicResource MutedText}"
                                                           FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding MacAddressText}" Foreground="{DynamicResource MutedText}"
                                                           FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding EnabledText}" HorizontalAlignment="Right" FontSize="11" />
                                                <TextBlock Text="{Binding TypeText}" Foreground="{DynamicResource MutedText}"
                                                           HorizontalAlignment="Right" FontSize="11" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="IPv4 配置" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="未管理地址在静态模式下会保留；DHCP 模式会清理手动地址。"
                                       Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,4,0,12" />
                            <TextBlock Text="IPv4 模式" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="DHCP 自动获取" IsChecked="{Binding IsDhcp}" GroupName="IpMode" />
                                <RadioButton Content="静态 IPv4" IsChecked="{Binding IsStatic}" GroupName="IpMode" />
                            </StackPanel>
                            <Grid IsEnabled="{Binding IsStatic}" Margin="0,0,0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Text="主 IPv4 地址" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding IPv4Address, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1" Text="子网掩码 / CIDR" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PrefixInput, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="2" Text="默认网关" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Gateway, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="DNS 配置" Style="{StaticResource SectionTitleStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="自动获取 DNS" IsChecked="{Binding IsDnsAutomatic}"
                                             GroupName="DnsMode" ToolTip="DNS 可选；需要时可切换为静态 DNS" />
                                <RadioButton Content="静态 DNS" IsChecked="{Binding IsDnsStatic}" GroupName="DnsMode" />
                            </StackPanel>
                            <Grid IsEnabled="{Binding IsDnsStatic}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Text="首选 DNS" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding PreferredDns, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1" Text="备用 DNS" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AlternateDns, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Border Background="{DynamicResource WarningBackground}" BorderBrush="{DynamicResource WarningBorder}"
                                    BorderThickness="1" CornerRadius="2" Padding="11" Margin="0,6,0,14">
                                 <TextBlock Text="{Binding ConfigurationNoticeText}"
                                            Foreground="{DynamicResource WarningText}" TextWrapping="Wrap" FontSize="12" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="1" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource HeaderBorder}"
                        BorderThickness="1" Padding="8" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="应用配置" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" Margin="4,0" />
                        <Button Content="保存为预设" Command="{Binding SavePresetCommand}" Style="{StaticResource QuietButton}" Margin="4,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="1">
                <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="预设" Style="{StaticResource SectionTitleStyle}" />
                                    <Border Background="{DynamicResource HeaderBadgeBackground}" BorderBrush="{DynamicResource HeaderBadgeBorder}"
                                            BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="PresetCountText" Text="{Binding PresetCountText}" Foreground="{DynamicResource PrimaryColor}" FontSize="11" />
                                    </Border>
                                </StackPanel>
                                <Button x:Name="PresetOverviewButton" Content="查看全部" Command="{Binding ViewAllPresetsCommand}" Style="{StaticResource QuietButton}"
                                        HorizontalAlignment="Right" Padding="10,4" ToolTip="打开窗口查看全部预设" />
                            </Grid>
                            <TextBlock Text="可复用的 IPv4 / DNS 模板" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,4,0,10" />
                            <TextBlock Text="分组筛选 / 搜索预设" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,0,0,1" />
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="135" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <ComboBox Width="135" ItemsSource="{Binding PresetGroups}" SelectedItem="{Binding PresetGroupFilter}"
                                          ToolTip="按分组筛选预设" />
                                <TextBox Grid.Column="1" Text="{Binding PresetSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="8,3,0,7" ToolTip="按预设名称或分组搜索" />
                            </Grid>
                             <WrapPanel Margin="0,1,0,12">
                                 <Button Content="应用" Command="{Binding ApplyPresetCommand}" CommandParameter="{Binding SelectedPreset}" Style="{StaticResource PrimaryButton}" />
                                 <Button Content="编辑" Command="{Binding EditPresetCommand}" Style="{StaticResource QuietButton}" />
                                 <Button Content="删除" Command="{Binding DeletePresetCommand}" Style="{StaticResource DangerButton}" />
                                 <Button x:Name="AddPresetGroupButton" Content="添加分组" Command="{Binding AddPresetGroupCommand}"
                                         Style="{StaticResource QuietButton}" />
                             </WrapPanel>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" MouseDoubleClick="PresetList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                            <TextBlock Text="{Binding AdapterSummary}" Foreground="{DynamicResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,8,2" />
                                            <TextBlock Grid.Column="1" Text="{Binding MacSummary}" Foreground="{DynamicResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="8,0,0,2" />
                                            <TextBlock Grid.Row="1" Text="{Binding IpSummary}" Foreground="{DynamicResource TextColor}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,8,2" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DnsSummary}" Foreground="{DynamicResource TextColor}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="8,0,0,2" />
                                            <TextBlock Grid.Row="2" Text="{Binding GroupName, StringFormat=分组：{0}}" Foreground="{DynamicResource PrimaryColor}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="8,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource HeaderBorder}"
                BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextColor}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DetailMessage}" Foreground="{DynamicResource DangerColor}" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Text="{Binding WarningMessage}" Foreground="{DynamicResource WarningText}" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource MutedText}"
                               VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding LastRefreshText}" Foreground="{DynamicResource MutedText}"
                               VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Border Background="{DynamicResource HeaderBadgeBackground}" BorderBrush="{DynamicResource HeaderBadgeBorder}"
                            BorderThickness="1" CornerRadius="2" Padding="11,7" Margin="0,0,8,0">
                        <TextBlock Text="管理员模式 · IPv4" Foreground="{DynamicResource PrimaryColor}" FontSize="12" />
                    </Border>
                    <Button Command="{Binding ToggleTopmostCommand}" Style="{StaticResource QuietButton}"
                            Width="40" Height="36" Padding="0" Margin="0,0,8,0"
                            ToolTip="{Binding TopmostToggleText}"
                            AutomationProperties.Name="{Binding TopmostToggleText}">
                        <TextBlock Text="{Binding TopmostIconText}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Content="打开系统网络连接" Command="{Binding OpenNetworkConnectionsCommand}"
                            Style="{StaticResource QuietButton}" ToolTip="打开系统控制面板中的网络连接" />
                    <Button Content="刷新网卡" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="OperationToast" Grid.Row="1"
                HorizontalAlignment="Center" VerticalAlignment="Center" Width="380"
                Margin="0" Padding="13,11" CornerRadius="4"
                Background="{DynamicResource CardBackground}" Panel.ZIndex="20"
                IsHitTestVisible="{Binding IsToastVisible}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessColor}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastSucceeded}" Value="False">
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerColor}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsToastVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.7" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="20" FontWeight="Bold" VerticalAlignment="Top"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="✓" />
                            <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastSucceeded}" Value="False">
                                    <Setter Property="Text" Value="!" />
                                    <Setter Property="Foreground" Value="{DynamicResource DangerColor}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="{Binding ToastTitle}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ToastDetail}" Foreground="{DynamicResource MutedText}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
