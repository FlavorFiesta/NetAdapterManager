 <Button.ToolTip><ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><TextBlock Text="{Binding ConfigurationNoticeText}" TextWrapping="Wrap"/></ToolTip></Button.ToolTip>
 </Button></StackPanel>
 <WrapPanel Margin="0,4,0,4"><RadioButton Content="{DynamicResource Loc_EE203172B7E7}" IsChecked="{Binding IsDnsAutomatic}" IsEnabled="{Binding IsDhcp}" GroupName="DnsMode" ToolTip="{DynamicResource Loc_989AA413A7FB}"/><RadioButton Content="{DynamicResource Loc_7046ECFB8361}" IsChecked="{Binding IsDnsStatic}" GroupName="DnsMode"/></WrapPanel>
 <Grid x:Name="StaticDnsFields" Visibility="{Binding IsDnsStatic, Converter={StaticResource BoolVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="136"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <TextBlock Text="{DynamicResource Loc_3EA51B185EAA}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding PreferredDns, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Loc_3EA51B185EAA}"/>
 <TextBlock Grid.Row="1" Text="{DynamicResource Loc_D3E3C8F130A7}" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AlternateDns, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Loc_D3E3C8F130A7}"/>
 </Grid>
 <TextBlock x:Name="EmptyDnsHint" Text="{DynamicResource Ops.EmptyDnsHint}" Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,4">
 <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
 <MultiDataTrigger><MultiDataTrigger.Conditions>
 <Condition Binding="{Binding IsDnsStatic}" Value="True"/>
 <Condition Binding="{Binding PreferredDns}" Value=""/>
 <Condition Binding="{Binding AlternateDns}" Value=""/>
 </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
 </Style.Triggers></Style></TextBlock.Style>
 </TextBlock></StackPanel>
 <TextBlock x:Name="DraftStatus" Text="{Binding DraftStatusText}" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,12"/>
 <Border Background="{DynamicResource PanelHeaderBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="10">
 <StackPanel>
 <Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <WrapPanel>
 <Button Content="{DynamicResource Draft.Restore}" Command="{Binding RestoreCurrentCommand}" Style="{StaticResource QuietButton}"/>
 <Button Content="{DynamicResource Loc_D2AA9AC606D7}" Command="{Binding SavePresetCommand}" Style="{StaticResource QuietButton}"/>
 </WrapPanel>
 <Button Grid.Column="1" Content="{DynamicResource Loc_670F0A1D31C0}" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="8,0,0,6"/>
 </Grid>
 <TextBlock Text="{DynamicResource Ops.ApplySaveHint}" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" FontSize="11"/></StackPanel>
 </Border></StackPanel></Border></ScrollViewer>
 </Grid>
 <Border x:Name="PresetLibraryPanel" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="14"><DockPanel>
 <StackPanel DockPanel.Dock="Top">
 <DockPanel><WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><Button x:Name="PresetOverviewButton" Content="{DynamicResource Loc_FA2FF3C379A7}" Command="{Binding ViewAllPresetsCommand}" Style="{StaticResource QuietButton}" Padding="8,5"/><Button x:Name="CollapsePresetLibraryButton" Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" Click="TogglePresetLibrary_Click" ToolTip="{DynamicResource Library.Collapse}" AutomationProperties.Name="{DynamicResource Library.Collapse}" Style="{StaticResource QuietButton}" MinWidth="30" Padding="6,5" Margin="0,0,0,6"/></WrapPanel><TextBlock Text="{DynamicResource Ops.Library}" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/></DockPanel>
 <TextBlock x:Name="PresetCountText" Text="{Binding PresetCountText}" FontSize="11" Foreground="{DynamicResource MutedText}" Margin="0,0,0,10"/>
 <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding PresetGroups}" ItemTemplate="{StaticResource GroupItemTemplate}" SelectedItem="{Binding PresetGroupFilter}" MinHeight="34" Padding="8,5"/>
 <Grid Grid.Column="1" Margin="8,0,0,0"><TextBox x:Name="TemplateSearch" Text="{Binding PresetSearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0" MinHeight="34" AutomationProperties.Name="{DynamicResource Ops.Search}"/><TextBlock TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{DynamicResource Ops.Search}" Foreground="{DynamicResource MutedText}" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding PresetSearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Grid>
 <WrapPanel Margin="0,0,0,6"><Button Content="{DynamicResource Loc_63C73C4730F4}" Command="{Binding ApplyPresetCommand}" CommandParameter="{Binding SelectedPreset}" Style="{StaticResource PrimaryButton}"/><Button Content="{DynamicResource Loc_051836569928}" Command="{Binding EditPresetCommand}" Style="{StaticResource QuietButton}"/><Button Content="{DynamicResource Loc_2F9DAA828907}" Command="{Binding DeletePresetCommand}" Style="{StaticResource QuietButton}"/><Button x:Name="AddPresetGroupButton" Content="{DynamicResource Loc_C3FA53918CC9}" Command="{Binding AddPresetGroupCommand}" Style="{StaticResource QuietButton}"/></WrapPanel>
 <WrapPanel Margin="0,0,0,10"><Button Content="{DynamicResource Transfer.Import}" Command="{Binding ImportPresetsCommand}" Style="{StaticResource QuietButton}"/><Button Content="{DynamicResource Ui.ExportSelected}" Command="{Binding ExportPresetsCommand}" Style="{StaticResource QuietButton}"/><Button Content="{DynamicResource Transfer.ExportAll}" Command="{Binding ExportPresetsCommand}" CommandParameter="all" Style="{StaticResource QuietButton}"/><Button Content="{DynamicResource Transfer.Bind}" Command="{Binding BindPresetCommand}" Style="{StaticResource QuietButton}"/></WrapPanel>
 <Border x:Name="CrossAdapterWarning" Background="{DynamicResource WarningBackground}" BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1" Padding="9" Margin="0,0,0,10" Visibility="{Binding IsCrossAdapter, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding CrossAdapterText}" TextWrapping="Wrap" Foreground="{DynamicResource WarningText}"/></Border>
 </StackPanel>
 <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" ItemTemplate="{StaticResource TemplateCard}" ItemContainerStyle="{StaticResource PresetListItemStyle}" MouseDoubleClick="PresetList_MouseDoubleClick"/>
 </DockPanel></Border>
 <Border x:Name="PresetLibraryRail" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
 <Button x:Name="ExpandPresetLibraryButton" Click="TogglePresetLibrary_Click"
         ToolTip="{DynamicResource Library.Expand}" AutomationProperties.Name="{DynamicResource Library.Expand}"
         Padding="6,10" Margin="0" FocusVisualStyle="{x:Null}">
 <Button.Template>
 <ControlTemplate TargetType="Button">
 <Border Background="Transparent" Padding="{TemplateBinding Padding}">
 <StackPanel VerticalAlignment="Top">
 <Border x:Name="ExpandArrowBackground" HorizontalAlignment="Center" CornerRadius="2" Padding="4,2" Margin="0,0,0,10">
 <TextBlock x:Name="ExpandArrow" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"/>
 </Border>
 <TextBlock Text="{DynamicResource Library.VerticalTitle}" TextAlignment="Center" TextWrapping="NoWrap" FontWeight="SemiBold"/>
 </StackPanel>
 </Border>
 <ControlTemplate.Triggers>
 <Trigger Property="IsMouseOver" Value="True">
 <Setter TargetName="ExpandArrowBackground" Property="Background" Value="{DynamicResource QuietBackground}"/>
 </Trigger>
 <Trigger Property="IsKeyboardFocused" Value="True">
 <Setter TargetName="ExpandArrowBackground" Property="Background" Value="{DynamicResource PrimaryColor}"/>
 <Setter TargetName="ExpandArrow" Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
 </Trigger>
 </ControlTemplate.Triggers>
 </ControlTemplate>
 </Button.Template>
 </Button></Border></Grid>
 <Border Grid.Row="1" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource HeaderBorder}" BorderThickness="0,1,0,0" Padding="14,6">
 <StackPanel><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <WrapPanel VerticalAlignment="Center"><TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" MaxWidth="260" FontSize="11" Margin="0,0,12,0" ToolTip="{Binding StatusMessage}"/><TextBlock Text="{Binding VersionText}" FontSize="10" Foreground="{DynamicResource MutedText}" Margin="0,0,10,0"/><TextBlock Text="{Binding LastRefreshText}" FontSize="10" Foreground="{DynamicResource MutedText}"/></WrapPanel>
 <WrapPanel x:Name="FooterActions" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
 <TextBlock Text="{Binding PrivilegeText}" FontSize="11" Foreground="{DynamicResource MutedText}" ToolTip="{DynamicResource Ops.PrivilegeHint}" VerticalAlignment="Center" Margin="0,0,10,6"/>
 <Button Command="{Binding ToggleTopmostCommand}" Content="{Binding TopmostIconText}" FontFamily="Segoe MDL2 Assets" ToolTip="{Binding TopmostToggleText}" Style="{StaticResource QuietButton}" Padding="8,5"/>
 <WrapPanel x:Name="ExpandedFooterActions">
 <Button Content="{DynamicResource Settings.Title}" Click="Settings_Click" Style="{StaticResource QuietButton}" Padding="8,5"/>
 <Button Content="{DynamicResource History.Title}" Command="{Binding DiagnosticsCommand}" Style="{StaticResource QuietButton}" Padding="8,5"/>
 <Button Content="{DynamicResource Ops.NetworkConnections}" Command="{Binding OpenNetworkConnectionsCommand}" ToolTip="{DynamicResource Loc_5E38EF80FE5A}" Style="{StaticResource QuietButton}" Padding="8,5"/>
 </WrapPanel>
 <Button x:Name="MoreActionsButton" Content="{DynamicResource Library.More}" Click="MoreActions_Click" Visibility="Collapsed" Style="{StaticResource QuietButton}" Padding="8,5">
 <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
 <MenuItem x:Name="CompactSettingsItem" Header="{DynamicResource Settings.Title}" Click="Settings_Click"/>
 <MenuItem x:Name="CompactDiagnosticsItem" Header="{DynamicResource History.Title}" Command="{Binding DiagnosticsCommand}"/>
 <MenuItem x:Name="CompactConnectionsItem" Header="{DynamicResource Ops.NetworkConnections}" Command="{Binding OpenNetworkConnectionsCommand}"/>
 </ContextMenu></Button.ContextMenu></Button>
 <Button x:Name="RefreshAdaptersButton" Content="{DynamicResource Loc_0D01866EE42E}" Command="{Binding RefreshCommand}" Style="{StaticResource QuietButton}" Padding="8,5" Margin="0,0,0,6"/>
 </WrapPanel></Grid>
 <TextBlock Text="{Binding DetailMessage}" Foreground="{DynamicResource DangerColor}" Style="{StaticResource OptionalStatusText}" FontSize="11"/>
 <TextBlock Text="{Binding WarningMessage}" Foreground="{DynamicResource WarningText}" Style="{StaticResource OptionalStatusText}" FontSize="11"/>
 </StackPanel></Border>
        <Border x:Name="OperationToast" Grid.Row="1"
                HorizontalAlignment="Center" VerticalAlignment="Center" Width="380"
                Margin="0" Padding="13,11" CornerRadius="4"
                Background="{DynamicResource CardBackground}" Panel.ZIndex="20"
                IsHitTestVisible="{Binding IsToastVisible}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessColor}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastSucceeded}" Value="False">
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerColor}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsToastVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.7" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock TextWrapping="Wrap" Grid.Column="0" FontSize="20" FontWeight="Bold" VerticalAlignment="Top"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="✓" />
                            <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastSucceeded}" Value="False">
                                    <Setter Property="Text" Value="!" />
                                    <Setter Property="Foreground" Value="{DynamicResource DangerColor}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock TextWrapping="Wrap" Text="{Binding ToastTitle}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ToastDetail}" Foreground="{DynamicResource MutedText}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

 </Grid></ScrollViewer></Window>
