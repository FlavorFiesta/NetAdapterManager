<Window x:Class="NetAdapterManager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:NetAdapterManager.ViewModels"
        Title="{DynamicResource Settings.Title}" Width="480" Height="380" MinWidth="440" MinHeight="350"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Icon="{StaticResource AppIcon}"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextColor}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock TextWrapping="Wrap" Text="{DynamicResource Settings.Language}" Style="{StaticResource SectionTitleStyle}"/>
            <ComboBox x:Name="LanguageBox" Margin="0,8,0,16" SelectionChanged="Preference_Changed" AutomationProperties.Name="{DynamicResource Settings.Language}">
                <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers>
                    <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                </Style.Triggers></Style></ComboBox.Style>
                <ComboBoxItem Tag="system" Content="{DynamicResource Settings.System}"/>
                <ComboBoxItem Tag="zh-CN" Content="{DynamicResource Loc_9937E365AAF3}"/>
                <ComboBoxItem Tag="zh-TW" Content="{DynamicResource Loc_1C95AB9B144E}"/>
                <ComboBoxItem Tag="en" Content="English"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <TextBlock TextWrapping="Wrap" Text="{DynamicResource Settings.Theme}" Style="{StaticResource SectionTitleStyle}"/>
            <ComboBox x:Name="ThemeBox" Margin="0,8,0,12" SelectionChanged="Preference_Changed" AutomationProperties.Name="{DynamicResource Settings.Theme}">
                <ComboBoxItem Tag="system" Content="{DynamicResource Settings.System}"/>
                <ComboBoxItem Tag="light" Content="{DynamicResource Settings.Light}"/>
                <ComboBoxItem Tag="dark" Content="{DynamicResource Settings.Dark}"/>
            </ComboBox>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="{DynamicResource Settings.Hint}" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}"/>
        <TextBlock x:Name="ErrorText" Grid.Row="3" TextWrapping="Wrap" Margin="0,8" Foreground="{DynamicResource DangerColor}"/>
        <Button Grid.Row="4" HorizontalAlignment="Right" Content="{DynamicResource Settings.Close}" Click="Close_Click" IsCancel="True"/>
    </Grid>
</Window>
