<Window x:Class="NetAdapterManager.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource Settings.Title}" Width="640" Height="700" MinWidth="480" MinHeight="580" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Icon="{StaticResource AppIcon}" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextColor}">
<Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TabControl Background="{DynamicResource CardBackground}" Foreground="{DynamicResource TextColor}">
<TabItem Header="{DynamicResource Settings.Title}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14">        <StackPanel>
            <TextBlock TextWrapping="Wrap" Text="{DynamicResource Settings.Language}" Style="{StaticResource SectionTitleStyle}"/>
            <ComboBox x:Name="LanguageBox" Margin="0,8,0,16" SelectionChanged="Preference_Changed" AutomationProperties.Name="{DynamicResource Settings.Language}">
                <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers>
                    <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                </Style.Triggers></Style></ComboBox.Style>
                <ComboBoxItem Tag="system" Content="{DynamicResource Settings.System}"/>
                <ComboBoxItem Tag="zh-CN" Content="{DynamicResource Loc_9937E365AAF3}"/>
                <ComboBoxItem Tag="zh-TW" Content="{DynamicResource Loc_1C95AB9B144E}"/>
                <ComboBoxItem Tag="en" Content="English"/>
            </ComboBox>
        </StackPanel>
        <StackPanel >
            <TextBlock TextWrapping="Wrap" Text="{DynamicResource Settings.Theme}" Style="{StaticResource SectionTitleStyle}"/>
            <ComboBox x:Name="ThemeBox" Margin="0,8,0,12" SelectionChanged="Preference_Changed" AutomationProperties.Name="{DynamicResource Settings.Theme}">
                <ComboBoxItem Tag="system" Content="{DynamicResource Settings.System}"/>
                <ComboBoxItem Tag="light" Content="{DynamicResource Settings.Light}"/>
                <ComboBoxItem Tag="dark" Content="{DynamicResource Settings.Dark}"/>
            </ComboBox>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="{DynamicResource Tray.CloseBehavior}" Style="{StaticResource SectionTitleStyle}"/>
            <ComboBox x:Name="CloseBehaviorBox" Margin="0,8,0,0" SelectionChanged="Preference_Changed"
                      AutomationProperties.Name="{DynamicResource Tray.CloseBehavior}">
                <ComboBoxItem Tag="Ask" Content="{DynamicResource Tray.Ask}"/>
                <ComboBoxItem Tag="MinimizeToTray" Content="{DynamicResource Tray.Minimize}"/>
                <ComboBoxItem Tag="Exit" Content="{DynamicResource Tray.Exit}"/>
            </ComboBox>
        </StackPanel>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="{DynamicResource Display.Title}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14">
<TextBlock Text="{DynamicResource Display.Title}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12"/>
<CheckBox x:Name="FollowDpiBox" Content="{DynamicResource Display.Follow}" Checked="Display_Changed" Unchecked="Display_Changed" Margin="0,0,0,12"/>
<WrapPanel><Button Content="{DynamicResource Display.Small}" Tag="small" Click="DisplayPreset_Click"/><Button Content="{DynamicResource Display.Default}" Tag="default" Click="DisplayPreset_Click"/><Button Content="{DynamicResource Display.Large}" Tag="large" Click="DisplayPreset_Click"/><Button Content="{DynamicResource Display.ExtraLarge}" Tag="xl" Click="DisplayPreset_Click"/></WrapPanel>
<DockPanel Margin="0,12,0,2"><TextBlock Text="{DynamicResource Display.Scale}"/><TextBlock Text="{Binding ElementName=UiScaleSlider, Path=Value, StringFormat={}{0:F0}%}" HorizontalAlignment="Right"/></DockPanel>
<Slider x:Name="UiScaleSlider" Minimum="75" Maximum="175" TickFrequency="5" IsSnapToTickEnabled="True" Value="100" ValueChanged="Display_Changed" AutomationProperties.Name="{DynamicResource Display.Scale}"/>
<DockPanel Margin="0,12,0,2"><TextBlock Text="{DynamicResource Display.Font}"/><TextBlock Text="{Binding ElementName=FontScaleSlider, Path=Value, StringFormat={}{0:F0}%}" HorizontalAlignment="Right"/></DockPanel>
<Slider x:Name="FontScaleSlider" Minimum="85" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True" Value="100" ValueChanged="Display_Changed" AutomationProperties.Name="{DynamicResource Display.Font}"/>
<Border Background="{DynamicResource PanelHeaderBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="12" Margin="0,16,0,12"><StackPanel x:Name="DisplayPreview"><TextBlock x:Name="DisplayPreviewText" Text="{DynamicResource Display.Preview}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="PreviewAddressText" Text="192.168.10.20 / 24" Margin="0,6,0,0" FontSize="12"/></StackPanel></Border>
<TextBlock Text="{DynamicResource Display.Hint}" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,14"/>
<WrapPanel><Button x:Name="ResetDisplayButton" Content="{DynamicResource Display.Reset}" Click="ResetDisplay_Click" Style="{StaticResource QuietButton}"/><Button x:Name="ApplyDisplayButton" Content="{DynamicResource Display.Apply}" Click="ApplyDisplay_Click" Style="{StaticResource PrimaryButton}"/></WrapPanel>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="{DynamicResource Updates.Check}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14">        <StackPanel >
            <TextBlock Text="{DynamicResource Settings.Hint}" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}"/>
            <TextBlock Text="{DynamicResource Updates.FeedLabel}" Margin="0,12,0,4" TextWrapping="Wrap"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{DynamicResource Updates.SaveFeed}" Click="SaveFallback_Click" Style="{StaticResource QuietButton}"/>
                <TextBox x:Name="FallbackUrlBox" AutomationProperties.Name="{DynamicResource Updates.FeedLabel}" VerticalContentAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="{DynamicResource Updates.FeedHint}" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}"/>
        </StackPanel>
        <Grid Margin="0,16,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="VersionStatus" TextWrapping="Wrap"/>
            <TextBlock x:Name="UpdateStatus" Grid.Row="1" TextWrapping="Wrap" Margin="0,6"/>
            <TextBox x:Name="ReleaseSummary" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="120" MaxHeight="200" AutomationProperties.Name="{DynamicResource Updates.Summary}"/>
            <WrapPanel Grid.Row="3" Margin="0,8">
                <Button x:Name="CheckUpdateButton" Content="{DynamicResource Updates.Check}" Click="CheckUpdate_Click" Style="{StaticResource QuietButton}"/>
                <Button x:Name="DownloadButton" Content="{DynamicResource Updates.Download}" Click="Download_Click" IsEnabled="False" Style="{StaticResource QuietButton}"/>
            </WrapPanel>
        </Grid>
</StackPanel></ScrollViewer></TabItem>
<TabItem x:Name="AdvancedTab" Header="{DynamicResource Settings.Advanced}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14">
            <TextBlock Text="{DynamicResource Settings.DhcpAdditionalTitle}" Style="{StaticResource SectionTitleStyle}"/>
            <DockPanel Margin="0,12,0,6">
                <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Ops.Adapter}" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding SelectedAdapter.Name, TargetNullValue=—}" FontWeight="SemiBold"/>
            </DockPanel>
            <TextBlock Text="{DynamicResource Settings.DhcpAdditionalHint}" Foreground="{DynamicResource MutedText}" Margin="0,0,0,8"/>
            <StackPanel IsEnabled="{Binding CanConfigure}">
                <TextBox x:Name="AdditionalAddressesBox" Text="{Binding AdditionalAddressesText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" MinHeight="90" VerticalScrollBarVisibility="Auto"
                         ToolTip="{DynamicResource Ops.AdditionalFormat}" AutomationProperties.Name="{DynamicResource Settings.DhcpAdditionalTitle}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDhcp}" Value="False">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</TabItem>
</TabControl>
<TextBlock x:Name="ErrorText" Grid.Row="1" TextWrapping="Wrap" Foreground="{DynamicResource DangerColor}" Margin="0,8"/>
<Button Grid.Row="2" Content="{DynamicResource Settings.Close}" Click="Close_Click" IsCancel="True" HorizontalAlignment="Right"/>
</Grid></Window>
