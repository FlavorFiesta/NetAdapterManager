<Window x:Class="NetAdapterManager.Views.PresetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:NetAdapterManager.ViewModels"
        Width="560" Height="620" MinWidth="520" MinHeight="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource TextColor}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1" CornerRadius="6" Padding="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Background="{DynamicResource HeaderBackground}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock TextWrapping="Wrap" Text="{DynamicResource Loc_3AB57DD1E321}" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
                <Button Content="×" Width="36" Height="32" Padding="0" Margin="0,5,6,5"
                        HorizontalAlignment="Right" Click="Close_Click" Style="{StaticResource QuietButton}" />
            </Grid>

            <ScrollViewer Grid.Row="1" Padding="14,12" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Background="{DynamicResource SoftBlue}" BorderBrush="{DynamicResource HeaderBadgeBorder}"
                            BorderThickness="1" CornerRadius="4" Padding="11" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Text="{DynamicResource Loc_A7785B7E395E}" Foreground="{DynamicResource MutedText}" FontSize="11" />
                            <TextBlock TextWrapping="Wrap" x:Name="AdapterNameText" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" />
                            <ComboBox x:Name="PresetAdapterSelector" Visibility="Collapsed" Margin="0,5,0,0"
                                      SelectionChanged="PresetAdapterSelector_SelectionChanged" MaxDropDownHeight="300">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinWidth="420">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock TextWrapping="Wrap" Grid.Column="1" Text="{Binding MacAddressText}" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="12,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock TextWrapping="Wrap" x:Name="AdapterMacText" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock TextWrapping="Wrap" Text="{DynamicResource Loc_5FE110AA6D1D}" Foreground="{DynamicResource MutedText}" FontSize="11" />
                            <TextBox x:Name="NameBox" Margin="0,3,0,7" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock TextWrapping="Wrap" Text="{DynamicResource Loc_399EE6934772}" Foreground="{DynamicResource MutedText}" FontSize="11" />
                            <ComboBox x:Name="GroupBox" ItemTemplate="{StaticResource GroupItemTemplate}" Margin="0,3,0,7"
                                      ToolTip="{DynamicResource Loc_CB6E877F881E}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="11" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Text="{DynamicResource Loc_5C26AEA1497D}" Style="{StaticResource SectionTitleStyle}" FontSize="15" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="DhcpRadio" Content="{DynamicResource Loc_620D67C03E6D}" GroupName="PresetIpMode" />
                                <RadioButton x:Name="StaticRadio" Content="{DynamicResource Loc_69050783CAFB}" GroupName="PresetIpMode" />
                            </StackPanel>
                            <Grid IsEnabled="{Binding ElementName=StaticRadio, Path=IsChecked}" Margin="0,0,0,1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="125" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock TextWrapping="Wrap" Text="{DynamicResource Loc_EDDFCE79A619}" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" x:Name="IpBox" />
                                <TextBlock TextWrapping="Wrap" Grid.Row="1" Text="{DynamicResource Loc_50832184B754}" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="PrefixBox" />
                                <TextBlock TextWrapping="Wrap" Grid.Row="2" Text="{DynamicResource Loc_51AAE58F282E}" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="GatewayBox" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="11" Margin="0,0,0,2">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Text="{DynamicResource Loc_F253293B1C7A}" Style="{StaticResource SectionTitleStyle}" FontSize="15" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="DnsAutomaticRadio" Content="{DynamicResource Loc_EE203172B7E7}" GroupName="PresetDnsMode"
                                             ToolTip="{DynamicResource Loc_989AA413A7FB}" />
                                <RadioButton x:Name="DnsStaticRadio" Content="{DynamicResource Loc_7046ECFB8361}" GroupName="PresetDnsMode" />
                            </StackPanel>
                            <Grid IsEnabled="{Binding ElementName=DnsStaticRadio, Path=IsChecked}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="125" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock TextWrapping="Wrap" Text="{DynamicResource Loc_3EA51B185EAA}" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" x:Name="PreferredDnsBox" />
                                <TextBlock TextWrapping="Wrap" Grid.Row="1" Text="{DynamicResource Loc_D3E3C8F130A7}" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="AlternateDnsBox" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ValidationMessage" Foreground="{DynamicResource DangerColor}"
                               TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource HeaderBorder}"
                    BorderThickness="0,1,0,0" Padding="14,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource Loc_2CD0F3BE8738}" Click="Cancel_Click" Style="{StaticResource QuietButton}" />
                    <Button x:Name="SavePresetButton" Content="{DynamicResource Loc_3AB57DD1E321}" Click="Save_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
