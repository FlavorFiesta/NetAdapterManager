<Window x:Class="NetAdapterManager.Views.PresetImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Transfer.Import}" Width="640" Height="480" MinWidth="460" MinHeight="300" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextColor}">
    <DockPanel Margin="16">
        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource Transfer.Import}" Click="Import_Click" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
            <Button Content="{DynamicResource Transfer.Cancel}" IsCancel="True" Style="{StaticResource QuietButton}"/>
        </WrapPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{DynamicResource Transfer.Notice}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <ComboBox x:Name="PolicyBox" SelectedIndex="0" AutomationProperties.Name="{DynamicResource Transfer.Policy}">
                <ComboBoxItem Content="{DynamicResource Transfer.Skip}"/>
                <ComboBoxItem Content="{DynamicResource Transfer.Replace}"/>
            </ComboBox>
        </StackPanel>
        <ListBox x:Name="RowsList" Margin="0,10,0,0">
            <ListBox.ItemTemplate><DataTemplate><StackPanel>
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                <TextBlock Text="{DynamicResource Transfer.Duplicate}" Foreground="{DynamicResource WarningText}">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding Conflict}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
            </StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
