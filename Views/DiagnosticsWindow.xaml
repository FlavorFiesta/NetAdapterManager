<Window x:Class="NetAdapterManager.Views.DiagnosticsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource History.Title}" Width="900" Height="760" MinWidth="620" MinHeight="480" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextColor}">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="140"/><RowDefinition Height="110"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{DynamicResource History.Notice}" TextWrapping="Wrap" Margin="0,0,0,8"/>
  <ListBox x:Name="HistoryList" Grid.Row="1" DisplayMemberPath="Summary" SelectionChanged="Selection_Changed" AutomationProperties.Name="{DynamicResource History.Title}"/>
  <TextBox x:Name="DetailBox" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource History.Details}"/>
  <StackPanel Grid.Row="3" Margin="0,8">
   <WrapPanel><CheckBox x:Name="HideIdentity" IsChecked="True" Content="{DynamicResource History.HideIdentity}" Click="Privacy_Changed"/>
    <CheckBox x:Name="HideMac" IsChecked="True" Content="{DynamicResource History.HideMac}" Click="Privacy_Changed" Margin="12,0"/>
    <CheckBox x:Name="HideIp" IsChecked="True" Content="{DynamicResource History.HideIp}" Click="Privacy_Changed"/></WrapPanel>
   <TextBlock Text="{DynamicResource History.RedactionNotice}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource MutedText}"/>
   <TextBlock Text="{DynamicResource History.Preview}" FontWeight="SemiBold" Margin="0,6,0,0"/>
  </StackPanel>
  <TextBox x:Name="PreviewBox" Grid.Row="4" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource History.Preview}"/>
  <StackPanel Grid.Row="5" Margin="0,10,0,0">
   <TextBlock x:Name="ActionStatus" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}"/>
   <WrapPanel HorizontalAlignment="Right">
    <Button Content="{DynamicResource History.CopyError}" Click="Copy_Click" Style="{StaticResource QuietButton}"/>
    <Button Content="{DynamicResource History.Export}" Click="Export_Click" Style="{StaticResource PrimaryButton}"/>
    <Button Content="{DynamicResource Settings.Close}" IsCancel="True" Style="{StaticResource QuietButton}"/>
   </WrapPanel>
  </StackPanel>
 </Grid>
</Window>
