<Window x:Class="NetAdapterManager.Views.AdapterBindingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Transfer.Bind}" Width="640" Height="350" MinWidth="460" MinHeight="280" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextColor}">
    <DockPanel Margin="16">
        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Transfer.Bind}" Click="Bind_Click" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
            <Button Content="{DynamicResource Transfer.Cancel}" IsCancel="True" Style="{StaticResource QuietButton}"/>
        </WrapPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock x:Name="OriginalText" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock Text="{DynamicResource Transfer.BindingNotice}" TextWrapping="Wrap"/>
            <ComboBox x:Name="AdapterBox" AutomationProperties.Name="{DynamicResource Transfer.Bind}" Margin="0,12">
                <ComboBox.ItemTemplate><DataTemplate><StackPanel>
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Snapshot.InterfaceGuid}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding MacAddressText}" TextWrapping="Wrap"/>
                </StackPanel></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel></ScrollViewer>
    </DockPanel>
</Window>
