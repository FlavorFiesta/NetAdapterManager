<Window x:Class="NetAdapterManager.Views.PresetGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:NetAdapterManager.ViewModels"
        Title="{DynamicResource Loc_AC23FC3625BD}" Width="420" Height="215" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource TextColor}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>
            <Grid Background="{DynamicResource HeaderBackground}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock TextWrapping="Wrap" Text="{DynamicResource Loc_AC23FC3625BD}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0" />
                <Button Content="×" Width="36" Height="32" Padding="0" Margin="0,6,6,6"
                        HorizontalAlignment="Right" Click="Cancel_Click" Style="{StaticResource QuietButton}" />
            </Grid>
            <StackPanel Grid.Row="1" Margin="16,14">
                <TextBlock TextWrapping="Wrap" Text="{DynamicResource Loc_D7E266BDC806}" Foreground="{DynamicResource MutedText}" FontSize="12" />
                <TextBox x:Name="GroupNameBox" Margin="0,6,0,0" MaxLength="60" />
                <TextBlock TextWrapping="Wrap" Text="{DynamicResource Loc_20DA51B784A7}"
                           Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,8,0,0" />
            </StackPanel>
            <Border Grid.Row="2" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource HeaderBorder}"
                    BorderThickness="0,1,0,0" Padding="14,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource Loc_2CD0F3BE8738}" Click="Cancel_Click" Style="{StaticResource QuietButton}" />
                    <Button Content="{DynamicResource Loc_7A8A11EAD507}" Click="Add_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
