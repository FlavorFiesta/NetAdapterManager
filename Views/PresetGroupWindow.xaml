<Window x:Class="NetAdapterManager.Views.PresetGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加预设分组" Width="420" Height="215" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>
            <Grid Background="{DynamicResource HeaderBackground}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="添加预设分组" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0" />
                <Button Content="×" Width="36" Height="32" Padding="0" Margin="0,6,6,6"
                        HorizontalAlignment="Right" Click="Cancel_Click" Style="{StaticResource QuietButton}" />
            </Grid>
            <StackPanel Grid.Row="1" Margin="16,14">
                <TextBlock Text="分组名称" Foreground="{DynamicResource MutedText}" FontSize="12" />
                <TextBox x:Name="GroupNameBox" Margin="0,6,0,0" MaxLength="60" />
                <TextBlock Text="添加后会保留在分组下拉框中，即使该分组暂时没有预设。"
                           Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,8,0,0" />
            </StackPanel>
            <Border Grid.Row="2" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource HeaderBorder}"
                    BorderThickness="0,1,0,0" Padding="14,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Click="Cancel_Click" Style="{StaticResource QuietButton}" />
                    <Button Content="添加" Click="Add_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
