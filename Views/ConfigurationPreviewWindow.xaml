<Window x:Class="NetAdapterManager.Views.ConfigurationPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Preview.Title}" Width="760" Height="520" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextColor}">
    <DockPanel Margin="16">
        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource Preview.Confirm}" IsDefault="True" Click="Confirm_Click" Style="{StaticResource PrimaryButton}"/>
            <Button Content="{DynamicResource Transfer.Cancel}" IsCancel="True" Style="{StaticResource QuietButton}"/>
        </WrapPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="IdentityText" TextWrapping="Wrap" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource Preview.Notice}" TextWrapping="Wrap" Margin="0,8"/>
            <TextBlock x:Name="WarningsText" TextWrapping="Wrap" Foreground="{DynamicResource WarningText}" Margin="0,0,0,8"/>
        </StackPanel>
        <DataGrid x:Name="ChangesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" HorizontalScrollBarVisibility="Auto" EnableRowVirtualization="False">
            <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers>
                <DataTrigger Binding="{Binding Changed}" Value="True"><Setter Property="FontWeight" Value="Bold"/></DataTrigger>
            </Style.Triggers></Style></DataGrid.RowStyle>
            <DataGrid.Resources>
                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="6"/></Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource Preview.Field}" Binding="{Binding Field}" Width="Auto"/>
                <DataGridTextColumn Header="{DynamicResource Preview.Current}" Binding="{Binding Current}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource Preview.Target}" Binding="{Binding Target}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
